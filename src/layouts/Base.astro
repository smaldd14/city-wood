---
import "../styles/global.css";
import { BUSINESS, TRACKING } from "../config";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const t = TRACKING;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="theme-color" content="#2b1d14" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<!-- Fonts: change here (and the --font-* variables in src/styles/global.css). -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;600;700&display=swap"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={BUSINESS.name} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Attribution: remember first-touch UTM / promo params for the session. -->
		<script is:inline>
			(function () {
				try {
					var p = new URLSearchParams(location.search);
					var keys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "ref", "promo"];
					var found = {};
					keys.forEach(function (k) { if (p.get(k)) found[k] = p.get(k); });
					if (Object.keys(found).length && !localStorage.getItem("cw_attr")) {
						found.landed = new Date().toISOString();
						localStorage.setItem("cw_attr", JSON.stringify(found));
					}
				} catch (e) {}
			})();
		</script>

		{t.plausibleDomain && (
			<script defer data-domain={t.plausibleDomain} src="https://plausible.io/js/script.tagged-events.js" />
		)}

		{t.metaPixelId && (
			<script is:inline define:vars={{ pixelId: t.metaPixelId }}>
				!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
				n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
				n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
				t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
				document,'script','https://connect.facebook.net/en_US/fbevents.js');
				fbq('init', pixelId);
				fbq('track', 'PageView');
			</script>
		)}

		{t.googleTagId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${t.googleTagId}`} />
				<script is:inline define:vars={{ gtagId: t.googleTagId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					window.gtag = gtag;
					gtag('js', new Date());
					gtag('config', gtagId);
				</script>
			</>
		)}

		<!-- Shared event helper: fans one event out to whichever tools are installed. -->
		<script is:inline define:vars={{ adsTag: t.googleTagId, adsLabel: t.googleAdsSubscribeLabel }}>
			window.cwTrack = function (name, props) {
				props = props || {};
				try { if (window.plausible) window.plausible(name, { props: props }); } catch (e) {}
				try {
					if (window.fbq) {
						if (name === "SubscribeClick") window.fbq("track", "InitiateCheckout", props);
						else if (name === "Subscribed") window.fbq("track", "Subscribe", props);
						else if (name === "Waitlist") window.fbq("track", "Lead", props);
						else window.fbq("trackCustom", name, props);
					}
				} catch (e) {}
				try {
					if (window.gtag) {
						window.gtag("event", name, props);
						if (name === "SubscribeClick" && adsTag && adsLabel && adsTag.indexOf("AW-") === 0) {
							window.gtag("event", "conversion", { send_to: adsTag + "/" + adsLabel });
						}
					}
				} catch (e) {}
			};
		</script>
	</head>
	<body>
		<slot />
		{t.cloudflareBeaconToken && (
			<script
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: t.cloudflareBeaconToken })}
			/>
		)}
	</body>
</html>
